# PostgreSQL connection used by SQLAlchemy (psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/fiji_flood_risk

# Generate a unique value for development; never commit the real secret.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Opt-in university workflow fixtures. Leave false outside a local demonstration.
ALERT_DEMO_ENABLED=false
# Open-browser delivery only; explicitly enable for a controlled local demo.
BROWSER_DELIVERY_ENABLED=false
# Lifetime stamped on newly approved alerts; public feed hides expired rows.
ALERT_TTL_HOURS=24
# Repeated-event window for automatic recommendations; 0 disables coalescing.
ALERT_COOLDOWN_HOURS=6
# Optional operator-owned directory; defaults to ../ml/artifacts from backend.
# RESEARCH_MODEL_DIR=/absolute/path/to/fiji-flood-risk-system/ml/artifacts

# Synthetic-only approval demonstration; separate tables and public feed.
SYNTHETIC_DEMO_ENABLED=false
# SYNTHETIC_MODEL_DIR=/absolute/path/to/ml/artifacts/synthetic/v1

# Weather: standalone worker, disabled until a canonical JSON feed is configured.
WEATHER_FRESHNESS_MINUTES=180
WEATHER_INGESTION_ENABLED=false
# WEATHER_FEED_URL=https://your-approved-provider.example/observations
WEATHER_FEED_SOURCE=configured-feed
# Keep true for any simulator/demo feed; false only for genuine observations.
WEATHER_FEED_SYNTHETIC=true
# WEATHER_FEED_TOKEN=operator-managed-secret
WEATHER_POLL_SECONDS=900
WEATHER_RETRY_ATTEMPTS=3
WEATHER_TIMEOUT_SECONDS=20
