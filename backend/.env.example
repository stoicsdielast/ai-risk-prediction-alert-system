# PostgreSQL connection used by SQLAlchemy (psycopg 3).
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/fiji_flood_risk

# Generate a unique value for development; never commit the real secret.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
